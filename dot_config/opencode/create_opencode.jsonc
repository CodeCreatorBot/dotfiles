{
  // OpenCode config — host-specific, rendered once at init, never overwritten.
  // Keep this minimal. Shared agents and skills live in
  // dot_config/opencode/{agents,skills} as managed files (sync on pull);
  // provide / model are configured per machine (never managed by chezmoi).
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,

  "permission": {
    "*": "ask",
    "write": "allow",
    "edit": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "todowrite": "allow",
    "gh_grep_*": "allow",
    "open-websearch_*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.kube/**": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/*id_rsa*": "deny",
      "**/*id_ed25519*": "deny",
      "**/*.kdbx": "deny"
    },
    "bash": {
      "*": "ask",

      "ls *": "allow",
      "ls": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "nl *": "allow",
      "tac *": "allow",
      "rev *": "allow",
      "od *": "allow",
      "xxd *": "allow",
      "hexdump *": "allow",
      "strings *": "allow",
      "bat *": "allow",
      "batcat *": "allow",
      "echo *": "allow",
      "printf *": "allow",

      "find *": "allow",
      "fd *": "allow",
      "fdfind *": "allow",
      "tree *": "allow",
      "tree": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "which *": "allow",
      "type *": "allow",
      "whereis *": "allow",
      "man *": "allow",
      "info *": "allow",
      "whatis *": "allow",
      "apropos *": "allow",

      "file *": "allow",
      "stat *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "cksum *": "allow",
      "sum *": "allow",
      "md5sum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",

      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "paste *": "allow",
      "join *": "allow",
      "comm *": "allow",
      "column *": "allow",
      "expand *": "allow",
      "unexpand *": "allow",
      "fmt *": "allow",
      "fold *": "allow",
      "pr *": "allow",
      "numfmt *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "sdiff *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "sed *": "allow",

      "zcat *": "allow",
      "bzcat *": "allow",
      "xzcat *": "allow",
      "zstdcat *": "allow",
      "zgrep *": "allow",
      "zless *": "allow",
      "zmore *": "allow",
      "zdiff *": "allow",
      "zcmp *": "allow",
      "gzip -l*": "allow",
      "gzip -c*": "allow",
      "gzip -dc*": "allow",
      "gzip -cd*": "allow",
      "gzip -? -c*": "allow",
      "gzip --list*": "allow",
      "gzip --stdout*": "allow",
      "gunzip -c*": "allow",
      "gunzip -l*": "allow",
      "gunzip --stdout*": "allow",
      "gunzip --list*": "allow",
      "bzip2 -c*": "allow",
      "bzip2 -dc*": "allow",
      "bunzip2 -c*": "allow",
      "xz -c*": "allow",
      "xz -dc*": "allow",
      "xz -l*": "allow",
      "xz --list*": "allow",
      "xz --stdout*": "allow",
      "unxz -c*": "allow",
      "zstd -c*": "allow",
      "zstd -d -c*": "allow",
      "zstd -l*": "allow",
      "unzip -l*": "allow",
      "unzip -p*": "allow",
      "zipinfo *": "allow",
      "tar -t*": "allow",
      "tar --list*": "allow",

      "pwd": "allow",
      "whoami": "allow",
      "id *": "allow",
      "id": "allow",
      "groups *": "allow",
      "groups": "allow",
      "uname *": "allow",
      "uname": "allow",
      "hostname": "allow",
      "arch": "allow",
      "nproc *": "allow",
      "nproc": "allow",
      "date *": "allow",
      "date": "allow",
      "uptime *": "allow",
      "uptime": "allow",
      "free *": "allow",
      "free": "allow",
      "locale *": "allow",
      "locale": "allow",
      "ulimit -a*": "allow",
      "ulimit": "allow",
      "env": "allow",
      "printenv *": "allow",
      "printenv": "allow",

      "ps *": "allow",
      "ps": "allow",
      "pgrep *": "allow",
      "pidof *": "allow",
      "lsof *": "allow",
      "ss *": "allow",
      "ss": "allow",
      "journalctl *": "allow",
      "lsblk *": "allow",
      "lsblk": "allow",
      "lscpu *": "allow",
      "lscpu": "allow",
      "lspci *": "allow",
      "lsusb *": "allow",
      "tput *": "allow",
      "getconf *": "allow",
      "getent *": "allow",
      "inxi *": "allow",
      "compgen *": "allow",
      "resolvectl status*": "allow",
      "rfkill list*": "allow",
      "ip link show*": "allow",
      "ip addr show*": "allow",
      "ip route show*": "allow",
      "ip -c link show*": "allow",
      "ip -c addr show*": "allow",
      "ip -c route show*": "allow",
      "ip -br addr": "allow",
      "ip -br link": "allow",
      "ip -br route": "allow",
      "systemctl status*": "allow",
      "systemctl is-active*": "allow",
      "systemctl is-enabled*": "allow",
      "systemctl is-failed*": "allow",
      "systemctl list-units*": "allow",
      "systemctl list-unit-files*": "allow",
      "systemctl list-timers*": "allow",
      "systemctl list-jobs*": "allow",
      "systemctl list-dependencies*": "allow",
      "systemctl show*": "allow",
      "systemctl cat*": "allow",
      "systemctl --version*": "allow",
      "systemctl --help*": "allow",
      "nmcli device show*": "allow",
      "nmcli connection show*": "allow",
      "nmcli general status*": "allow",

      "true": "allow",
      "false": "allow",
      "test *": "allow",
      "[ *": "allow",
      "[[ *": "allow",
      "expr *": "allow",
      "bc *": "allow",
      "seq *": "allow",
      "sleep *": "allow",
      "read *": "allow",
      "read": "allow",
      "history": "allow",
      "alias": "allow",
      "alias -p*": "allow",
      "command -v*": "allow",
      "command -V*": "allow",
      "bash -n*": "allow",
      "bash --version*": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git fetch*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git shortlog*": "allow",
      "git describe*": "allow",
      "git ls-files*": "allow",
      "git ls-remote*": "allow",
      "git ls-tree*": "allow",
      "git cat-file*": "allow",
      "git count-objects*": "allow",
      "git reflog*": "allow",
      "git merge-base*": "allow",
      "git name-rev*": "allow",
      "git cherry*": "allow",
      "git help*": "allow",
      "git var*": "allow",
      "git whatchanged*": "allow",
      "git annotate*": "allow",
      "git show-ref*": "allow",
      "git rev-list*": "allow",
      "git check-ignore*": "allow",
      "git range-diff*": "allow",
      "git --version*": "allow",
      "git config --get*": "allow",
      "git config --get-all*": "allow",
      "git config --get-regexp*": "allow",
      "git config --get-urlmatch*": "allow",
      "git config --list*": "allow",
      "git config -l*": "allow",
      "git tag --list*": "allow",
      "git tag -l*": "allow",
      "git stash list*": "allow",
      "git worktree list*": "allow",
      "git submodule status*": "allow",
      "git remote": "allow",
      "git remote -v*": "allow",
      "git remote show*": "allow",
      "git remote get-url*": "allow",

      "git -C * status*": "allow",
      "git -C * diff*": "allow",
      "git -C * log*": "allow",
      "git -C * show*": "allow",
      "git -C * branch*": "allow",
      "git -C * rev-parse*": "allow",
      "git -C * fetch*": "allow",
      "git -C * blame*": "allow",
      "git -C * grep*": "allow",
      "git -C * ls-files*": "allow",
      "git -C * describe*": "allow",
      "git -C * shortlog*": "allow",
      "git -C * cat-file*": "allow",
      "git -C * reflog*": "allow",
      "git -C * merge-base*": "allow",
      "git -C * rev-list*": "allow",
      "git -C * show-ref*": "allow",
      "git -C * check-ignore*": "allow",
      "git -C * ls-tree*": "allow",
      "git -C * name-rev*": "allow",
      "git -C * count-objects*": "allow",
      "git -C * ls-remote*": "allow",
      "git -C * cherry*": "allow",
      "git -C * var*": "allow",
      "git -C * whatchanged*": "allow",
      "git -C * annotate*": "allow",
      "git -C * range-diff*": "allow",
      "git -C * help*": "allow",
      "git -C * config --get*": "allow",
      "git -C * config --list*": "allow",

      "pacman -Q*": "allow",
      "pacman -Ss*": "allow",
      "pacman -Si*": "allow",
      "pacman -Sl*": "allow",
      "pacman -Fs*": "allow",
      "pacman -T*": "allow",
      "dpkg -l*": "allow",
      "dpkg -s*": "allow",
      "dpkg -L*": "allow",
      "dpkg -S*": "allow",
      "dpkg -p*": "allow",
      "dpkg -c*": "allow",
      "dpkg -I*": "allow",
      "dpkg -C*": "allow",
      "dpkg --print-architecture*": "allow",
      "dpkg --compare-versions*": "allow",
      "apt list*": "allow",
      "apt show*": "allow",
      "apt-cache *": "allow",
      "dnf list*": "allow",
      "dnf info*": "allow",
      "dnf search*": "allow",
      "dnf repoquery*": "allow",
      "dnf provides*": "allow",
      "dnf repolist*": "allow",
      "dnf deplist*": "allow",
      "dnf check-update*": "allow",
      "rpm -q*": "allow",
      "flatpak list*": "allow",
      "flatpak info*": "allow",
      "flatpak search*": "allow",
      "flatpak remotes*": "allow",
      "snap list*": "allow",
      "snap info*": "allow",
      "snap find*": "allow",
      "winget list*": "allow",
      "winget search*": "allow",
      "winget show*": "allow",
      "winget --version*": "allow",
      "npm view*": "allow",
      "npm --version*": "allow",
      "npm -v*": "allow",
      "npm list*": "allow",
      "npm ls*": "allow",
      "npm outdated*": "allow",
      "npm search*": "allow",
      "npm ping*": "allow",
      "npm explain*": "allow",
      "pnpm -v*": "allow",
      "pnpm --version*": "allow",
      "pnpm view*": "allow",
      "pnpm list*": "allow",
      "pnpm ls*": "allow",
      "pnpm outdated*": "allow",
      "pnpm why*": "allow",
      "pnpm root*": "allow",
      "pnpm bin*": "allow",

      "git push *": "ask",
      "git push* main*": "deny",
      "git push* master*": "deny",
      "git push* dev*": "deny",
      "sed *-i*": "deny",
      "yq *-i*": "deny",
      "date -s*": "deny",
      "date --set*": "deny",
      "sort *-o*": "deny",
      "find *-delete*": "deny",
      "find *-exec*": "deny",
      "find *-ok*": "deny",
      "find *-fprint*": "deny",
      "find *-fls*": "deny",
      "journalctl --vacuum*": "deny",
      "journalctl --rotate*": "deny",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny"
    }
  },

  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    // Open-source multi-engine web search (duckduckgo/bing/brave/...) — the
    // open replacement for the closed-source exa MCP. Uses npx at startup.
    "open-websearch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "open-websearch@latest"],
      "env": {
        "MODE": "stdio",
        "DEFAULT_SEARCH_ENGINE": "duckduckgo"
      },
      "enabled": true
    }
  },

  "tools": {
    // Set to true (or remove) to enable the playwright test tools when the
    // opencode_playwright bundle is turned on.
    "playwright*": false
  }
}
