{
  // OpenCode config — host-specific, rendered once at init, never overwritten.
  // Keep this minimal. Shared agents and skills live in
  // dot_config/opencode/{agents,skills} as managed files (sync on pull);
  // provide / model are configured per machine (never managed by chezmoi).
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,

  "permission": {
    "*": "ask",
    "write": "allow",
    "edit": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "todowrite": "allow",
    "gh_grep_*": "allow",
    "open-websearch_*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.kube/**": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/*id_rsa*": "deny",
      "**/*id_ed25519*": "deny",
      "**/*.kdbx": "deny"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "ls": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "less *": "allow",
      "more *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "df *": "allow",
      "du *": "allow",
      "env": "allow",
      "printenv *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "printf *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git fetch*": "allow",
      "git push *": "ask",
      "git push* main*": "deny",
      "git push* master*": "deny",
      "git push* dev*": "deny",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny"
    }
  },

  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    // Open-source multi-engine web search (duckduckgo/bing/brave/...) — the
    // open replacement for the closed-source exa MCP. Uses npx at startup.
    "open-websearch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "open-websearch@latest"],
      "env": {
        "MODE": "stdio",
        "DEFAULT_SEARCH_ENGINE": "duckduckgo"
      },
      "enabled": true
    }
  },

  "tools": {
    // Set to true (or remove) to enable the playwright test tools when the
    // opencode_playwright bundle is turned on.
    "playwright*": false
  }
}
