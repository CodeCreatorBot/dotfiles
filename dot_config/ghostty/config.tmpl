# Caelestia renders the dynamic theme to this path on every scheme/wallpaper
# change (see dot_config/caelestia/templates/theme.ghostty). Reload with
# `ctrl+shift+,` to pick up changes, or restart ghostty.
theme = {{ .chezmoi.homeDir }}/.local/state/caelestia/theme/theme.ghostty
shell-integration-features = ssh-terminfo
