#!/usr/bin/env bash
# Arch — dev packages + toolchains (run once, before dotfiles).
# Package data: .chezmoidata/packages.arch.yaml + packages.toolchains.yaml.
# env={{ .env }}
set -eu

# Self-gate: chezmoi runs every run_ script on every OS.
[ -f /etc/arch-release ] || { echo "Skip: not Arch"; exit 0; }

# ── package lists ───────────────────────────────────────────────────────

PKG_PACMAN=({{ range .arch.dev }}"{{ . }}" {{ end }})

CURL_INSTALLERS=({{ range .toolchains.curlInstallers }}"{{ .name }}|{{ .url }}|{{ .sh }}|{{ .post }}" {{ end }})

# ── confirmation ────────────────────────────────────────────────────────

echo
echo "==> Arch dev tooling (env={{ .env }})"
echo
echo "  pacman: ${PKG_PACMAN[*]}"
for entry in "${CURL_INSTALLERS[@]}"; do
	IFS='|' read -r name url interpreter post <<<"$entry"
	printf '  curl:   %s' "$name"
	[ -n "$post" ] && printf ' (+ %s)' "$post"
	echo
done
echo
read -rp "Install the above? [y/N] " yn
case "$yn" in
	[Yy]*) ;;
	*)
		echo "Aborted."
		exit 0
		;;
esac

# ── pacman ──────────────────────────────────────────────────────────────

sudo pacman -Sy --needed --noconfirm "${PKG_PACMAN[@]}"

# ── toolchains ──────────────────────────────────────────────────────────

export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

set -o pipefail  # curl | sh failures must not be masked

for entry in "${CURL_INSTALLERS[@]}"; do
	IFS='|' read -r name url interpreter post <<<"$entry"
	echo "==> $name"
	if command -v "$name" >/dev/null 2>&1; then
		echo "    already installed — skipping"
	else
		# shellcheck disable=SC2086
		curl -fsSL "$url" | $interpreter
	fi
	if [ -n "$post" ]; then
		sh -c "$post"
	fi
done

echo
echo "Done."
