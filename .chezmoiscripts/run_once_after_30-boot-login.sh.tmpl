#!/usr/bin/env bash
# Boot/login polish: install vendored omarchy plymouth+sddm themes, sddm autologin (run_once_after_).
#
# One password per boot: themed plymouth LUKS unlock is the single prompt;
# sddm auto-logs into Hyprland (greeter only on logout/lock). Themes are
# chezmoi-managed at ~/.local/share/{plymouth,sddm}/themes/omarchy — edit
# those and re-sync to /usr/share to see changes.
{{- if or (ne (.env | default "dev") "desktop") (ne .chezmoi.os "linux") (not (.caelestia | default false)) }}
echo "Skip: needs env=desktop + linux + caelestia"
exit 0
{{- else }}
set -eu
[ -f /etc/arch-release ] || { echo "Skip: not Arch"; exit 0; }
command -v plymouth-set-default-theme >/dev/null 2>&1 || { echo "Skip: plymouth absent"; exit 0; }
command -v sddm >/dev/null 2>&1 || { echo "Skip: sddm absent"; exit 0; }

# ── plymouth: install theme, set default (-R also rebuilds initrd) ──
sudo install -d /usr/share/plymouth/themes/omarchy
sudo cp -a "$HOME/.local/share/plymouth/themes/omarchy/." /usr/share/plymouth/themes/omarchy/
sudo plymouth-set-default-theme -R omarchy

# ── sddm: install theme + one drop-in (theme + autologin) + enable ──
sudo install -d /usr/share/sddm/themes/omarchy /etc/sddm.conf.d
sudo cp -a "$HOME/.local/share/sddm/themes/omarchy/." /usr/share/sddm/themes/omarchy/
sudo tee /etc/sddm.conf.d/10-omarchy.conf >/dev/null <<EOF
[Theme]
Current=omarchy

[Autologin]
User=$USER
Session=hyprland
EOF
sudo systemctl enable sddm.service
{{- end }}