#!/usr/bin/env bash
# Arch desktop layer — run once, AFTER dotfiles (run_once_after_).
#
# Flag-gated: packages come from .chezmoidata/packages.arch.yaml as
# arch.desktop.<flag>.<installer> (shape: os.env.[flag].installer); flag
# VALUES come from chezmoi.toml [data]. The template walks every flag in
# the data file and renders only the enabled ones — toggling a switch
# changes the rendered content → new checksum → this script re-runs (and
# re-prompts). Adding an app = YAML group + chezmoi.toml switch; no script
# edit. Desktop toolchains come from packages.toolchains.yaml
# (toolchains.desktop.*). env={{ .env }}
{{- if or (ne (.env | default "dev") "desktop") (ne .chezmoi.os "linux") }}
echo "Skip: env=desktop + Arch only"
exit 0
{{- else }}
set -eu

# Self-gate: chezmoi runs every run_ script on every OS.
[ -f /etc/arch-release ] || { echo "Skip: not Arch"; exit 0; }

# ── collect packages (flag-gated) ───────────────────────────────────────
# Walk arch.desktop flags → bash arrays. Installer mapping:
# pacman/aur/flatpak install; services/groups are post-install side effects.

PKG_PACMAN=()
PKG_AUR=()
FLATPAKS=()
SERVICES_ENABLE=()
GROUPS_ADD=()

{{ range $flag, $entry := .arch.desktop -}}
{{- if not (hasKey $ $flag) }}
echo "WARN: '{{ $flag }}' is in packages.arch.yaml but has no chezmoi.toml switch — skipped"
{{- else if index $ $flag }}
	# {{ $flag }}
{{- range $inst, $pkgs := $entry -}}
{{- if eq $inst "pacman" }}
PKG_PACMAN+=({{ range $pkgs }}"{{ . }}" {{ end }})
{{- else if eq $inst "aur" }}
PKG_AUR+=({{ range $pkgs }}"{{ . }}" {{ end }})
{{- else if eq $inst "flatpak" }}
FLATPAKS+=({{ range $pkgs }}"{{ . }}" {{ end }})
{{- else if eq $inst "services" }}
SERVICES_ENABLE+=({{ range $pkgs }}"{{ . }}" {{ end }})
{{- else if eq $inst "groups" }}
GROUPS_ADD+=({{ range $pkgs }}"{{ . }}" {{ end }})
{{- else }}
echo "WARN: '{{ $flag }}': unknown installer '{{ $inst }}' — skipped"
{{- end }}
{{- end }}
{{- end }}
{{- end }}

# Desktop toolchains (desktop, always — from packages.toolchains.yaml)
CURL_INSTALLERS=({{ range .toolchains.desktop.curlInstallers }}"{{ .name }}|{{ .url }}|{{ .sh }}|{{ .post }}" {{ end }})
VOLTA_TOOLS=({{ range .toolchains.desktop.voltaTools }}"{{ .tool }}" {{ end }})

# CachyOS ships cachyos/noctalia-qs (repo fork of quickshell) which hijacks
# the quickshell-git dep of caelestia-shell and kills the shell — skip the
# shell package on CachyOS; see docs/caelestia-cachyos-quickshell-fix.md.
CAELESTIA_SKIP_SHELL=false
{{ if index . "caelestia" }}
if [ -f /etc/os-release ] && grep -qi 'cachyos' /etc/os-release; then
	echo "==> CachyOS detected: skipping caelestia-shell (quickshell fork hijack)"
	echo "    after this run, follow docs/caelestia-cachyos-quickshell-fix.md"
	CAELESTIA_SKIP_SHELL=true
	for i in "${!PKG_AUR[@]}"; do
		if [ "${PKG_AUR[$i]}" = "caelestia-shell" ]; then
			unset 'PKG_AUR[$i]'
		fi
	done
	PKG_AUR=("${PKG_AUR[@]}")
fi
{{ end }}

# base-devel is needed to build AUR packages
if [ ${#PKG_AUR[@]} -gt 0 ]; then
	PKG_PACMAN+=(base-devel)
fi

# ── confirmation ────────────────────────────────────────────────────────

echo
echo "==> Arch desktop packages (env={{ .env }})"
echo
if [ ${#PKG_PACMAN[@]} -gt 0 ]; then
	echo "  pacman:  ${PKG_PACMAN[*]}"
fi
if [ ${#PKG_AUR[@]} -gt 0 ]; then
	echo "  aur:     ${PKG_AUR[*]}"
fi
if [ ${#FLATPAKS[@]} -gt 0 ]; then
	echo "  flatpak: ${FLATPAKS[*]}"
fi
if [ ${#SERVICES_ENABLE[@]} -gt 0 ]; then
	echo "  services (enable --now): ${SERVICES_ENABLE[*]}"
fi
if [ ${#GROUPS_ADD[@]} -gt 0 ]; then
	echo "  groups (add $USER):      ${GROUPS_ADD[*]}"
fi
if [ ${#CURL_INSTALLERS[@]} -gt 0 ]; then
	for entry in "${CURL_INSTALLERS[@]}"; do
		IFS='|' read -r name url interpreter post <<<"$entry"
		printf '  curl:    %s' "$name"
		[ -n "$post" ] && printf ' (+ %s)' "$post"
		echo
	done
fi
if [ ${#VOLTA_TOOLS[@]} -gt 0 ]; then
	echo "  volta:   ${VOLTA_TOOLS[*]}"
fi
echo
read -rp "Install the above? [y/N] " yn
case "$yn" in
	[Yy]*) ;;
	*)
		echo "Aborted."
		exit 0
		;;
esac

# ── pacman (full upgrade — a plain -Sy partial upgrade can resolve
#    libav* deps against stale packages and fail the transaction) ─────────

if [ ${#PKG_PACMAN[@]} -gt 0 ]; then
	sudo pacman -Syu --needed --noconfirm "${PKG_PACMAN[@]}"
fi

# ── AUR (bootstrap yay if needed) ───────────────────────────────────────

if [ ${#PKG_AUR[@]} -gt 0 ]; then
	if ! command -v yay >/dev/null 2>&1; then
		echo "==> yay: not found — bootstrapping"
		tmp="$(mktemp -d)"
		git clone https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
		sh -c "cd '$tmp/yay-bin' && makepkg -si --noconfirm"
		rm -rf "$tmp"
	fi
	echo "==> yay: ${PKG_AUR[*]}"
	yay -S --needed --noconfirm "${PKG_AUR[@]}"
fi

# ── caelestia (post-install) ─────────────────────────────────────────────

if command -v caelestia >/dev/null 2>&1; then
	if [ ! -f "${XDG_STATE_HOME:-$HOME/.local/state}/caelestia/scheme.json" ]; then
		echo "==> caelestia: create default scheme"
		caelestia scheme set -n caelestia || echo "    (deferred — run 'caelestia scheme set -n caelestia' in-session)"
	fi
	echo "==> caelestia: shell + cli installed."
	if $CAELESTIA_SKIP_SHELL; then
		echo "    (CachyOS: caelestia-shell skipped — quickshell fork hijack;"
		echo "     follow docs/caelestia-cachyos-quickshell-fix.md)"
	fi
	echo "    Hand over the desktop visuals in your Wayland session:"
	echo "      caelestia install   # select ONLY the 'hypr' component!"
	echo "    (Other components overwrite chezmoi-managed files, e.g."
	echo "     starship.toml / lazygit — skip them.)"
fi

# ── flatpak ─────────────────────────────────────────────────────────────

if [ ${#FLATPAKS[@]} -gt 0 ]; then
	if ! command -v flatpak >/dev/null 2>&1; then
		echo "==> installing flatpak"
		sudo pacman -Sy --needed --noconfirm flatpak
	fi
	if ! flatpak remote-list 2>/dev/null | grep -q flathub; then
		echo "==> adding flathub remote"
		flatpak remote-add --if-not-exists \
			flathub https://flathub.org/repo/flathub.flatpakrepo
	fi
	echo "==> flatpak: ${FLATPAKS[*]}"
	flatpak install -y flathub "${FLATPAKS[@]}"
fi

# ── desktop toolchains ──────────────────────────────────────────────────

export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$HOME/.local/bin:$PATH"

set -o pipefail  # curl | sh failures must not be masked

for entry in "${CURL_INSTALLERS[@]}"; do
	IFS='|' read -r name url interpreter post <<<"$entry"
	echo "==> $name"
	if command -v "$name" >/dev/null 2>&1; then
		echo "    already installed — skipping"
	else
		# shellcheck disable=SC2086
		curl -fsSL "$url" | $interpreter
	fi
	if [ -n "$post" ]; then
		sh -c "$post"
	fi
done

for tool in "${VOLTA_TOOLS[@]}"; do
	echo "==> volta install $tool"
	volta install "$tool"
done

# ── services + groups ───────────────────────────────────────────────────

for svc in "${SERVICES_ENABLE[@]}"; do
	echo "==> service: enable --now $svc"
	sudo systemctl enable --now "$svc"
done
for grp in "${GROUPS_ADD[@]}"; do
	if id -nG "$USER" 2>/dev/null | grep -qw "$grp"; then
		echo "user already in group $grp"
	else
		echo "==> group: add $USER to $grp"
		sudo usermod -aG "$grp" "$USER"
	fi
done

echo
echo "Done."
{{- end }}
