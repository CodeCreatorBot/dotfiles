#!/usr/bin/env bash
# Ubuntu — dev packages + toolchains (run once, before dotfiles).
# Package data: .chezmoidata/packages.ubuntu.yaml (ubuntu.dev.apt) +
# packages.toolchains.yaml (toolchains.dev.*). Shape: os.env.[flag].installer.
# env={{ .env }}
set -eu

# Self-gate: chezmoi runs every run_ script on every OS.
if grep -qs '^ID=ubuntu' /etc/os-release 2>/dev/null; then
	:
else
	echo "Skip: not Ubuntu"
	exit 0
fi

# ── package lists ───────────────────────────────────────────────────────

PKG_APT=({{ range .ubuntu.dev.apt }}"{{ . }}" {{ end }})

CURL_INSTALLERS=({{ range .toolchains.dev.curlInstallers }}"{{ .name }}|{{ .url }}|{{ .sh }}|{{ .post }}" {{ end }})

# ── confirmation ────────────────────────────────────────────────────────

echo
echo "==> Ubuntu dev tooling (env={{ .env }})"
echo
echo "  apt:    ${PKG_APT[*]}"
for entry in "${CURL_INSTALLERS[@]}"; do
	IFS='|' read -r name url interpreter post <<<"$entry"
	printf '  curl:   %s' "$name"
	[ -n "$post" ] && printf ' (+ %s)' "$post"
	echo
done
echo
read -rp "Install the above? [y/N] " yn
case "$yn" in
	[Yy]*) ;;
	*)
		echo "Aborted."
		exit 0
		;;
esac

# ── apt ─────────────────────────────────────────────────────────────────

sudo apt-get update
sudo apt-get install -y "${PKG_APT[@]}"

# ── toolchains ──────────────────────────────────────────────────────────

export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

set -o pipefail  # curl | sh failures must not be masked

for entry in "${CURL_INSTALLERS[@]}"; do
	IFS='|' read -r name url interpreter post <<<"$entry"
	echo "==> $name"
	if command -v "$name" >/dev/null 2>&1; then
		echo "    already installed — skipping"
	else
		# shellcheck disable=SC2086
		curl -fsSL "$url" | $interpreter
	fi
	if [ -n "$post" ]; then
		sh -c "$post"
	fi
done

echo
echo "Done."
