# .chezmoiignore — env-driven. Single source of truth: [data] in chezmoi.toml.
# Patterns match TARGET paths (after dot_ prefix stripping), not source paths.

# ── Repo-internal files (never applied) ──
# NOTE: chezmoi v2.71 breaks all patterns after a directory-glob match on
# an existing source dir, so archive entries are explicit filenames.
# Add each new archived file here.
AGENTS.md
.config/AGENTS.md
LICENSE
README.md
.pre-commit-config.yaml
tests/**
docs/caelestia-cachyos-quickshell-fix.md

# ── Per-host secrets (never tracked; sourced if present) ──
.bash.d/secrets.sh
.bash.d/local.sh
.config/powershell/secrets.ps1

# ── Windows work tooling (env = work-dev AND windows OS) ──
{{ if or (ne (.env | default "dev") "work-dev") (ne .chezmoi.os "windows") }}
.config/powershell/**
{{ end }}

# ── Azure DevOps / corporate work tooling (env = work-dev) ──
{{ if ne (.env | default "dev") "work-dev" }}
.config/opencode/skills/azure-devops-cli/**
.pi/agent/agents/ticketer.md
.pi/agent/mcp.json
{{ end }}

# ── opencode agent/skill bundles (opt-in switches, default OFF) ──
{{ $pw := false }}{{ if hasKey . "opencode_playwright" }}{{ $pw = .opencode_playwright }}{{ end }}
{{ if not $pw }}
.config/opencode/agents/playwright-*
.config/opencode/skills/playwright-cli/**
{{ end }}

# ── Desktop environment (env = desktop only) ──
{{ if ne (.env | default "dev") "desktop" }}
.config/caelestia/**
.config/obsidian/**
.bash_d/colors.sh
{{ end }}

# ── Desktop hand-offs to caelestia (env = desktop) ──
# caelestia's `starship` dot overwrites ~/.config/starship.toml, so chezmoi
# stops managing it on desktop; it stays managed on dev/work-dev.
{{ if eq (.env | default "dev") "desktop" }}
.config/starship.toml
{{ end }}

# ── Desktop sub-switches (env = desktop, per-tool opt-outs) ──
# caelestia is the desktop-shell composite (replaces waybar, dunst, walker,
# matugen, satty, elephant, wallpapers + the old gated hypr tree); only the
# thin ~/.config/caelestia/ override hooks are chezmoi-managed.
{{ if and (eq (.env | default "dev") "desktop") (not (.caelestia | default false)) }}
.config/caelestia/**
{{ end }}
{{ if and (eq (.env | default "dev") "desktop") (not (.onedrive | default false)) }}
.config/onedrive/**
.config/systemd/user/onedrive.service
{{ end }}
{{ if and (eq (.env | default "dev") "desktop") (not (.obsidian | default false)) }}
.config/obsidian/**
{{ end }}

# ── Local AI stack (env = desktop, ai switch) ──
{{ if and (eq (.env | default "dev") "desktop") (not (.ai | default false)) }}
.config/systemd/user/screenpipe.service
.config/ai/**
{{ end }}
